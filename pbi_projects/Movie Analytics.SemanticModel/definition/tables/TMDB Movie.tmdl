				    #"Base - Rename Columns" = Table.RenameColumns(#"Base - Select Columns",{{"budget", "Budget"}, {"genres", "Genres"}, {"original_language", "Original Language"}, {"popularity", "Popularity"}, {"production_countries", "Prod. Countries"}, {"release_date", "Release Date"}, {"revenue", "Revenue"}, {"runtime", "Runtime Min."}, {"title", "Title"}, {"vote_average", "Vote Avg."}, {"vote_count", "Vote #"}, {"id", "TMDB ID"}, {"status", "Status"}}),
				    #"Base - Change Type" = Table.TransformColumnTypes(#"Base - Rename Columns",{{"TMDB ID", Int64.Type}, {"Title", type text}, {"Vote Avg.", type number}, {"Vote #", Int64.Type}, {"Status", type text}, {"Release Date", type date}, {"Revenue", Int64.Type}, {"Runtime Min.", Int64.Type}, {"Budget", Int64.Type}, {"Original Language", type text}, {"Popularity", type number}, {"Genres", type text}, {"Prod. Countries", type text}}),
				    #"Null - Handle Budget" = Table.ReplaceValue(#"Base - Change Type",0,null,Replacer.ReplaceValue,{"Budget"}),
				    #"Cleanse - Keep Released only" = Table.SelectRows(#"Null - Handle Budget", each ([Status] = "Released")),
				    #"Cleanse - Keep Vote # > 9" = Table.SelectRows(#"Cleanse - Keep Released only", each [#"Vote #"] > 9),
				    #"Cleanse - Remove null date" = Table.SelectRows(#"Cleanse - Keep Vote # > 9", each [Release Date] <> null and [Release Date] <> ""),
				    #"Cleanse - Shorten US" = Table.ReplaceValue(#"Cleanse - Remove null date","United States of America","US",Replacer.ReplaceText,{"Prod. Countries"}),
				    #"Cleanse - Shorten UK" = Table.ReplaceValue(#"Cleanse - Shorten US","United Kingdom","UK",Replacer.ReplaceText,{"Prod. Countries"}),
				    #"Enrich - Add Runtime Category" = Table.AddColumn(#"Cleanse - Shorten UK", "Runtime Category", each if [#"Runtime Min."] < 40 then "1.Short (<40m)" else if [#"Runtime Min."] < 90 then "2.Feature (<90m)" else if [#"Runtime Min."] < 180 then "3.Feature (<3h)" else if [#"Runtime Min."] <= 300 then "4.Feature (3h-5h)" else if [#"Runtime Min."] > 300 then "5.Long (>5h)" else null),
				    #"Enrich - Add Release Year" = Table.AddColumn(#"Enrich - Add Runtime Category", "Release Year", each Date.Year([Release Date]), Int64.Type),
				    #"Enrich - Add Release Year Cate." = Table.AddColumn(#"Enrich - Add Release Year", "Release Year Cate.", each if [Release Year] < 1980 then "1.Before 1980s" else if [Release Year] < 1990 then "2.1980s" else if [Release Year] < 2000 then "3.1990s" else if [Release Year] < 2010 then "4.2000s" else if [Release Year] < 2020 then "5.2010s" else if [Release Year] >= 2020 then "6.Since 2020s" else null),
				    #"Enrich - Add Vote # Group" = Table.AddColumn(#"Enrich - Add Release Year Cate.", "Vote # Group", each if [#"Vote #"] >= 2000 then "1.High" else if [#"Vote #"] >= 300 then "2.Normal" else if [#"Vote #"] < 300 then "3.Low" else null),
				    #"Cleanse - Remove nouse columns" = Table.RemoveColumns(#"Enrich - Add Vote # Group",{"Status", "Release Date"})
